# Server Configuration
APP_NAME=Tiket.in Backend API
APP_PORT=3000
APP_ROLE=all
LOG_LEVEL=info

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tiket_in
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=tiket_in
MONGO_MAX_POOL=20

# JWT Configuration
JWT_SECRET=super-secret-key-tiket-in-development-minimum-32-chars
JWT_ISSUER=tiket-in-backend
JWT_ACCESS_TTL_MINUTES=60

